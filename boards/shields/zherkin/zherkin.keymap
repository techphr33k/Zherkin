#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&lt {
    tapping-term-ms = <150>;     // LAYER TAP SPEED default=200
};

&mt {
    tapping-term-ms = <150>;    // MOD-TAP SPEED default=200
};

    // define KEYMAP LAYERS here



/ {

#define  QWERTY 0
#define  L1 1
#define  L2 2
#define  L3 3
#define  R1 4
#define  R2 5
#define  R3 6


    keymap {
        compatible = "zmk,keymap";

           QWERTY  {
            display-name = "QWERTY";
            bindings = <
                &kp Q      &kp W     	&kp E     	&kp R     	&kp T    	    &kp Y     	    &kp U     	&kp I     	    &kp O     	   &kp P
                &lt 1 A    &lt 2 S    &kp D     	&kp F     	&mt LSHIFT G    &mt RSHIFT H    &kp J     	&kp K     	    &lt 5 L        &lt 4 SEMI
                &lt 3 Z    &kp X     	&kp C     	&kp V     	&kp B    	    &kp N     	    &kp M     	&mt RCTRL COMMA &mt RALT DOT   &lt 6 FSLH
            >;
        };
                L1 {
            display-name = "L1";
            bindings = <
                &none    &none    &none    &none    &none    &none     &none    &none    &none    &kp BSPC 
                &trans   &none    &none    &none    &none    &none     &none    &none    &none    &none 
                &none    &none    &none    &none    &none    &none     &none    &none    &none    &kp RET 
            >;
        };
                L2 {
            display-name = "L2";
            bindings = <
                &none    &none    &none    &none    &none    &none     &none    &none    &none    &none 
                &none    &trans   &none    &none    &none    &none     &none    &none    &none    &none 
                &none    &none    &none    &none    &none    &none     &none    &none    &none    &none 
            >;
        };
                L3 {
            display-name = "L3";
            bindings = <
                &bootloader &bt BT_CLR      &bt BT_PRV    &bt BT_NXT    &none           &none           &none    &none    &none    &none 
                &none       &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4    &none    &none    &none    &none     
                &trans      &none           &none         &none         &none           &none           &none    &none    &none    &none
            >;
        };
                R1 {
            display-name = "R1";
            bindings = <
                &kp ESC  &none    &none    &none    &none    &none     &none    &none    &none    &none 
                &none    &none    &none    &none    &none    &none     &none    &none    &none    &trans 
                &kp TAB  &none    &none    &none    &none    &none     &none    &none    &none    &none 
            >;
        };
                R2 {
            display-name = "R2";
            bindings = <
                &none    &none    &none    &none    &none    &none     &none    &none    &none    &none 
                &none    &none    &none    &none    &none    &none     &none    &none    &trans   &none 
                &none    &none    &none    &none    &none    &none     &none    &none    &none    &none 
            >;
        };
                R3 {
            display-name = "R3";
            bindings = <
                &none    &none    &none    &none    &none    &none     &none    &none    &none    &none 
                &none    &none    &none    &none    &none    &none     &none    &none    &none    &none 
                &none    &none    &none    &none    &none    &none     &none    &none    &none    &trans
        };
    };
};
