// zherkin overlay

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: key_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <3>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
        >;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row"; 

        row-gpios = <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>, // Left-side P1.00 (D6)
                    <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; // Left-side P0.11 (D7)

        col-gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>, // Right-side P0.31 (D21)
                    <&gpio0 29 GPIO_ACTIVE_HIGH>, // Right-side P0.29 (D20)
                    <&gpio0 2  GPIO_ACTIVE_HIGH>, // Right-side P0.02 (D19)
                    <&gpio1 15 GPIO_ACTIVE_HIGH>, // Right-side P1.15 (D18)
                    <&gpio1 13 GPIO_ACTIVE_HIGH>, // Right-side P1.13 (D15)
                    <&gpio1 11 GPIO_ACTIVE_HIGH>, // Right-side P1.11 (D14)
                    <&gpio0 10 GPIO_ACTIVE_HIGH>, // Right-side P0.10 (D16)
                    <&gpio0 9  GPIO_ACTIVE_HIGH>, // Right-side P0.09 (D10)
                    <&gpio1 6  GPIO_ACTIVE_HIGH>, // Left-side P1.06 (D9)
                    <&gpio1 4  GPIO_ACTIVE_HIGH>; // Left-side P1.04 (D8)
    };
};
